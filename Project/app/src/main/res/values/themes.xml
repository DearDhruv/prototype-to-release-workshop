<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window background matches the Compose theme so there is no white/black flash at launch or behind transitions. -->
    <style name="Theme.PTR" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ptr_window_background</item>
        <item name="android:colorBackground">@color/ptr_window_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ptr_window_background</item>
    </style>
</resources>
